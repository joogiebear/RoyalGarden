<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mystipixel</groupId>
    <artifactId>royalgarden</artifactId>
    <version>2026.39.0</version>
    <packaging>jar</packaging>

    <name>RoyalGarden</name>
    <description>The Garden, as an eco extension of RoyalSkyblock.</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          A default for local builds only. CI overrides it with -Droyalskyblock.version, read from
          the host source it builds and installs, so this value never decides what CI compiles
          against. It used to be written inline on the dependency, where a host release left it
          stale and the Maven cache hid the consequence: the restored ~/.m2 still held the old
          artifact, so the build stayed green while compiling against an API the running host no
          longer has.
        -->
        <royalskyblock.version>2026.36.1</royalskyblock.version>
        <!-- As royalskyblock.version: a local default; CI passes the host's own libreforge-version. -->
        <libreforge.version>2026.35.1</libreforge.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!--
          eco comes from here, NOT from the jar on the server. The shipped jar is shaded, with its
          Kotlin relocated to com.willfp.eco.libs.kotlin, and installing it into the local repository
          silently shadows the published artifact - the local repo wins over remote ones, so the
          failure then looks like the published artifact being broken. Only RoyalSkyblock is
          hand-installed, because only RoyalSkyblock is genuinely unpublished.
        -->
        <repository>
            <id>auxilor</id>
            <url>https://repo.auxilor.io/repository/maven-public/</url>
        </repository>
        <!-- PlaceholderAPI, for the %royalgarden_...% expansion. Same repository and version as the host. -->
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <!--
          eco and RoyalSkyblock are installed into the local repository from the
          jars the server actually runs, by tools/install-deps.ps1. Neither is
          published anywhere this build can reach, and pinning to the running
          jars means the extension is compiled against exactly the API it will
          meet at runtime.
        -->
        <dependency>
            <groupId>com.willfp</groupId>
            <artifactId>eco</artifactId>
            <version>2026.33</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mystipixel</groupId>
            <artifactId>royalskyblock</artifactId>
            <version>${royalskyblock.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.2.build.123-stable</version>
            <scope>provided</scope>
        </dependency>
        <!--
          Provided, never required: the expansion that uses it is only constructed once PlaceholderAPI is
          enabled, and resolves at runtime because RoyalSkyblock soft-depends on PlaceholderAPI.
        -->
        <!--
          libreforge, for crop upgrades' effect holders. The host runs on it, so it is always present at
          runtime and our classes resolve it through the host's class loader. The shadow classifier is the
          artifact the host's own build compiles against.
        -->
        <dependency>
            <groupId>com.willfp</groupId>
            <artifactId>libreforge</artifactId>
            <version>${libreforge.version}</version>
            <classifier>shadow</classifier>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.13.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>RoyalGarden</finalName>
        <resources>
            <!--
              Only extension.yml is filtered (for its version). The shipped configs are full of
              %placeholders% and @-free text today, but filtering them would turn any future ${...} or
              @...@ in a message into a build-time substitution nobody asked for.
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>extension.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>extension.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
        </plugins>
    </build>
</project>
